%% -*- erlang -*-
[
    {config, [
        #{
            files => ["src/**/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_block_expressions, disable},
                {elvis_style, private_data_types, disable}
            ]
        },
        #{
            files => ["test/**/*.erl"],
            ruleset => erl_files,
            rules => [
                {elvis_style, no_block_expressions, disable},
                {elvis_style, no_debug_call, disable}
            ]
        }
    ]}
].

